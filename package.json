{
  "name": "conan-setup-action",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "packageManager": "npm",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "test": "npx jest",
    "format:check": "npx prettier --check .",
    "format:write": "npx prettier --write .",
    "lint": "npx eslint .",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/planetmarshall/conan-setup-action.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@github/local-action": "^2.2.1",
    "@jest/globals": "^30.5.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ts-md5": "^1.3.1"
  }
}
